# Dashboard auth (public-facing)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong-password
SESSION_SECRET=replace-with-long-random-string

# GOWA (internal Docker network only)
GOWA_BASE_URL=http://gowa:3000
GOWA_BASIC_AUTH=gowa:change-me-gowa-password
GOWA_IMAGE=aldinokemal2104/go-whatsapp-web-multidevice:v9.0.1
# Device slot used for QR login and sending (created automatically if missing)
GOWA_DEVICE_ID=main

# Campaign worker delays (ms)
CAMPAIGN_DELAY_MIN_MS=3000
CAMPAIGN_DELAY_MAX_MS=10000
# Max upload size for campaign media (bytes). Per-type caps still apply: image 16MB, video 100MB, file 50MB.
MEDIA_MAX_UPLOAD_BYTES=104857600

# HTTP listen (dashboard container)
PORT=8080
NODE_ENV=production
DATA_DIR=/app/data
COOKIE_SECURE=false

# Optional HTTPS via Caddy (leave DOMAIN empty for plain HTTP)
DOMAIN=
ACME_EMAIL=
ENABLE_HTTPS=false
